<button class="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Day mode" data-theme-toggle>
  <svg class="theme-icon theme-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
  <svg class="theme-icon theme-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14A9 9 0 0 1 10 3.5 9 9 0 1 0 20.5 14Z"/></svg>
  <span class="theme-label">Day mode</span><span class="theme-track" aria-hidden="true"><span></span></span>
</button>
<script>
  const syncTheme = () => {
    const day = document.documentElement.dataset.theme === 'day';
    document.querySelectorAll('[data-theme-toggle]').forEach(button => button.setAttribute('aria-checked', String(day)));
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', day ? '#f5f3e9' : '#211d19');
  };
  document.addEventListener('click', event => {
    if (!(event.target instanceof Element) || !event.target.closest('[data-theme-toggle]')) return;
    const theme = document.documentElement.dataset.theme === 'day' ? 'night' : 'day';
    document.documentElement.dataset.theme = theme;
    try { localStorage.setItem('emran-theme', theme); } catch { /* Theme still works when storage is unavailable. */ }
    syncTheme();
  });
  document.addEventListener('astro:before-swap', event => {
    event.newDocument.documentElement.dataset.theme = document.documentElement.dataset.theme || 'night';
  });
  document.addEventListener('astro:page-load', syncTheme);
  window.addEventListener('storage', event => {
    if (event.key !== 'emran-theme') return;
    document.documentElement.dataset.theme = event.newValue === 'day' ? 'day' : 'night';
    syncTheme();
  });
  syncTheme();
</script>
