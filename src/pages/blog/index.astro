---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { href } from '../../data/profile';
const posts = (await getCollection('blog', ({data}) => !data.draft)).sort((a,b) => b.data.date.getTime() - a.data.date.getTime());
---
<Layout title="Blog" selectedItem="blog"><header><h1>Blog</h1><p class="lead">Notes on mathematics, computing, and other interests.</p></header>{posts.length ? <section class="post-list" aria-label="Blog posts">{posts.map(post => <a href={href(`blog/${post.id}/`)} class="post-entry"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'})}</time><h2>{post.data.title}</h2><p>{post.data.description}</p></a>)}</section> : <p class="empty-state">No posts yet. Check back soon.</p>}</Layout>
