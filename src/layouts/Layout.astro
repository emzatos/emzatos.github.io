---
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { profile } from '../data/profile';
import '../styles/styles.css';
interface Props { title?: string; description?: string; selectedItem: string }
const { title, description, selectedItem } = Astro.props;
---
<!doctype html>
<html lang="en">
  <Header title={title ? `${title} | ${profile.name}` : profile.name} description={description} />
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="content"><Sidebar selectedItem={selectedItem} /><main id="main" class="main"><div class="container"><slot /><footer class="site-footer">© {new Date().getFullYear()} {profile.name}</footer></div></main></div>
  </body>
</html>
